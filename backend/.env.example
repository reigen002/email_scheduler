# Backend Environment Variables
# Copy this to .env and fill in your values

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5433/email_scheduler

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Get these from https://console.cloud.google.com/
# 1. Create a project
# 2. Configure the OAuth consent screen and add your test users
# 3. Create OAuth 2.0 credentials (Web Application)
# 4. Add authorized redirect URI: http://localhost:3001/api/auth/google/callback
# 5. Add authorized JavaScript origin: http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_random_64_char_hex_string_in_production
JWT_EXPIRES_IN=7d

# ─── BullMQ Worker Settings ───────────────────────────────────────────────────
# How many email jobs to process concurrently
WORKER_CONCURRENCY=5

# Minimum delay between individual email sends (milliseconds)
# Default: 2000ms (2 seconds), enforced queue-wide across workers
MIN_DELAY_BETWEEN_SENDS_MS=2000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Maximum emails per hour per sender email address
# Jobs exceeding this limit are rescheduled to the next hour window (not dropped)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
